# =============================================================================
# Backend Next.js — plantilla de variables de entorno
# =============================================================================
# Copia este archivo a `.env.local` para desarrollo local y rellena los valores
# reales. NUNCA subas `.env.local` (ni credenciales reales) al repositorio:
# está ignorado por `.gitignore`.
#
# En Vercel, define estas mismas variables en:
#   Project -> Settings -> Environment Variables
# y vuelve a desplegar (Deployments -> Redeploy) para que tomen efecto.
#
# REGLA DE SEGURIDAD: sólo las variables con prefijo `NEXT_PUBLIC_` llegan al
# navegador. Todo lo demás (secretos, service_role, LiveKit, MailerSend) es
# PRIVADO y debe quedarse SIEMPRE en el servidor.
# =============================================================================

# ---------------------------------------------------------------------------
# 1) Supabase (privadas — sin NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Project URL: Supabase -> Project Settings -> API -> Project URL.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave publicable / anon. Supabase -> Project Settings -> API -> Project API keys.
# (No es un secreto crítico, pero se mantiene privada porque sólo la usa el servidor.)
SUPABASE_ANON_KEY=TU_ANON_O_PUBLISHABLE_KEY
# Alias aceptado por el código (si tu panel la llama "publishable key"):
# SUPABASE_PUBLISHABLE_KEY=TU_PUBLISHABLE_KEY

# SECRETO CRÍTICO: nunca debe exponerse al navegador ni con prefijo NEXT_PUBLIC_.
# Sólo lo usan rutas de administración (gestión de usuarios / sesiones).
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# 2) LiveKit (privadas — IMPRESCINDIBLES para las transmisiones en vivo)
# ---------------------------------------------------------------------------
# Sin estas tres variables, la ruta POST /api/transmisiones/[id]/token responde
# 503 y el frontend muestra:
#   "La emisión en tiempo real no está disponible: al servidor le faltan las
#    credenciales de LiveKit."
#
# Cómo obtenerlas:
#   A) LiveKit Cloud (recomendado): https://cloud.livekit.io -> crea un proyecto.
#      Project Settings -> Keys -> "Add key" y copia API Key y API Secret.
#      La URL del servidor es wss://<tu-proyecto>.livekit.cloud
#   B) Self-hosting: usa la URL de tu servidor (wss://...) y las claves de tu
#      archivo `livekit.yaml` (keys: <API_KEY>: <API_SECRET>).
#
# LIVEKIT_URL debe ser el endpoint WebSocket (wss://...) del servidor de medios.
LIVEKIT_URL=wss://TU-PROYECTO.livekit.cloud
LIVEKIT_API_KEY=TU_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=TU_LIVEKIT_API_SECRET

# ---------------------------------------------------------------------------
# 3) Frontend Angular y URLs del backend
# ---------------------------------------------------------------------------
# ÚNICA variable pública permitida: origen del frontend Angular autorizado para
# CORS y para volver tras el login con Google.
NEXT_PUBLIC_ANGULAR_URL=http://localhost:4200

# Opcional. Sólo se usa como último recurso si la petición no trae cabecera de
# host. En producción se prefiere SIEMPRE `host`/`x-forwarded-host` de Vercel.
# No lo apuntes a un deployment temporal (Vercel lo elimina y provoca 410 GONE).
# SITE_URL=https://tu-backend.vercel.app

# ---------------------------------------------------------------------------
# 4) Mantenimiento automático (Vercel Cron)
# ---------------------------------------------------------------------------
# Secreto compartido que Vercel envía en la cabecera
# `Authorization: Bearer <CRON_SECRET>` al ejecutar los crons.
#
# Qué hace: cada 5 minutos (ver `vercel.json`) el cron
#   GET /api/cron/cerrar-transmisiones-huerfanas
# cierra las transmisiones que quedaron `en_vivo` pero cuya sala de LiveKit ya
# no tiene participantes (el anfitrión cerró el navegador sin finalizar).
#
# Genera un valor aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si no se define, el endpoint responde 401 y ningún cron puede ejecutarse.
CRON_SECRET=TU_CRON_SECRET_ALEATORIO

# ---------------------------------------------------------------------------
# 5) MailerSend (privadas — correo transaccional)
# ---------------------------------------------------------------------------
MAILERSEND_API_KEY=TU_MAILERSEND_API_KEY
MAIL_FROM=no-reply@tudominio.com
MAIL_FROM_NAME=LiveMarket

# NOTA sobre Google OAuth:
#   El login con Google del flujo actual lo gestiona SUPABASE (signInWithOAuth).
#   GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET se configuran en el panel de Supabase
#   (Authentication -> Providers -> Google), NO en Vercel ni en este archivo.
#   La URL de callback que debes registrar en Google Cloud Console es:
#   https://<TU-PROYECTO>.supabase.co/auth/v1/callback
